{
  "name": "@kompilador/hce-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Historia clínica electrónica en la nube - By Kompilador",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate:prod": "node dist/scripts/migrate.js",
    "migrate": "tsx scripts/migrate.ts",
    "tenant": "tsx scripts/create-tenant.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
